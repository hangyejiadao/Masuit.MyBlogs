# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder as docker-compose.yml) and adjust.
# The GitHub Actions deploy pipeline overwrites only the IMAGE line.
# ---------------------------------------------------------------------------

# Container image to run (set by CI, or point to your own tag manually)
IMAGE=ghcr.io/hangyejiadao/masuit.myblogs:latest

# Host port that exposes the web app. Put a reverse proxy (Nginx/Caddy) in
# front of it for TLS, or change Protocol settings in appsettings.json.
APP_PORT=5000

# --- PostgreSQL (only used by the bundled "postgres" service) --------------
POSTGRES_USER=postgres
# CHANGE THIS to a strong password, and use the same value in
# appsettings.json -> Database:ConnString
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=myblogs

# --- Redis ----------------------------------------------------------------
# Redis is only reachable inside the compose network, so no password is set.
# Use the same value in appsettings.json -> Redis
REDIS_PORT=6379
