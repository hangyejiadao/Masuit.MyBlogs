@using System.Web
@using Masuit.MyBlogs.Core.Common
@using Masuit.MyBlogs.Core.Configs
@using Masuit.MyBlogs.Core.Models.DTO
@using Masuit.MyBlogs.Core.Models.ViewModel
@using Masuit.Tools.AspNetCore.Extensions
@model Masuit.MyBlogs.Core.Models.Entity.Post
@{
  ViewBag.Title = Model.Title;
  Layout = "~/Views/Shared/_Layout.cshtml";
  string hidden = string.IsNullOrEmpty(Context.Request.Cookies["ValidateKey"]) ? "" : "hidden";
  AdvertisementDto ad = ViewBag.Ads;
  var blogUser = Context.Session.Get<UserInfoDto>(SessionKey.UserInfo);
  var loginReturnUrl = System.Net.WebUtility.UrlEncode(Context.Request.Path + Context.Request.QueryString);
}
<script src="~/UEditorPlus/ueditor.config.front.js"></script>
<script charset="utf-8" src="~/UEditorPlus/ueditor.all.js" type="text/javascript"></script>
<script src="https://cdn.jsdelivr.net/npm/dayjs/dayjs.min.js"></script>
<script>
  window.defaultUser=function(){
    return {
      NickName: `@Context.Request.Cookies["NickName"]`,
      Email: `@Context.Request.Cookies["Email"]`,
      Agree:true,
      IsAdmin:true,
      voteDownCount:@Model.VoteDownCount,
      voteUpCount:@Model.VoteUpCount
    };
  }
  window.blogUser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { isLogin = blogUser != null, nickName = blogUser?.NickName ?? "", email = blogUser?.Email ?? "" }));
</script>
<div class="container" id="postApp">
  <ol class="breadcrumb">
    <li>
      <a asp-action="Index" asp-controller="Home">首页</a>
    </li>
    <li>
      <a asp-action="Post" asp-controller="Home">文章列表</a>
    </li>
    @if (Model.Category.ParentId > 0) {
      if (Model.Category.Parent.ParentId > 0) {
        <li>
          <a asp-action="Category" asp-controller="Home" asp-route-id="@Model.Category.Parent.ParentId">@Model.Category.Parent.Parent.Name</a>
        </li>
      }

      <li>
        <a asp-action="Category" asp-controller="Home" asp-route-id="@Model.Category.ParentId">@Model.Category.Parent.Name</a>
      </li>
    }
    <li>
      <a asp-action="Category" asp-controller="Home" asp-route-id="@Model.CategoryId">@Model.Category.Name</a>
    </li>
    <li class="current">
      <em>@ViewBag.Title</em>
    </li>
  </ol>
  <div class="main-container">
    <!-- 头部信息 -->
    <section class="article-header">
      <div class="article-title-row">
        <h2 class="article-title">@Html.Raw(Model.Title)</h2>
        @if (!Model.Locked) {
          <a asp-action="PushMerge" asp-controller="Post" asp-route-id="@Model.Id">
            <button class="article-op-btn">我要参与编辑</button>
          </a>
        }
      </div>
      <div class="article-meta-row">
        <div>
          <span class="author">
            <a asp-action="Author" asp-controller="Home" asp-route-author="@Model.Author">@Model.Author</a>
          </span>
          <span>
            发布于
            <a asp-action="Archieve" asp-controller="Home" asp-route-dd="@Model.PostDate.Day" asp-route-mm="@Model.PostDate.Month" asp-route-mode="@nameof(Model.PostDate)" asp-route-yyyy="@Model.PostDate.Year">
              <time class="text-info">@Model.PostDate.ToString("yyyy-MM-dd HH:mm:ss")</time>
            </a>
          </span>
        </div>
        <div>
          <span class="modifier">
            <a asp-action="Author" asp-controller="Home" asp-route-author="@Model.Modifier">@Model.Modifier</a>
          </span>
          <span>
            修改于
            <a asp-action="Archieve" asp-controller="Home" asp-route-dd="@Model.ModifyDate.Day" asp-route-mm="@Model.ModifyDate.Month" asp-route-mode="@nameof(Model.ModifyDate)" asp-route-yyyy="@Model.ModifyDate.Year">
              <time class="text-success">@Model.ModifyDate.ToString("yyyy-MM-dd HH:mm")</time>
            </a>
          </span>
        </div>
        <span>评论数：@ViewBag.CommentsCount</span>
        <span>
          正在浏览：
          <span class="text-red">{{online}}人</span>
        </span>
      </div>
      <div class="article-meta-row">
        <div class="article-tags-row">
          <span style="font-weight:600;color:#1566b6;font-size:1.06rem;">
            <i class="icon-map-pin"></i>分类：
            <span class="article-tag">
              @{
                await Html.RenderPartialAsync("CategoryPath", Model.Category);
              }
            </span>
          </span>
        </div>
        @if (Model.Seminar.Any()) {
          <div class="article-tags-row">
            <span style="font-weight:600;color:#1566b6;font-size:1.06rem;">所属专题：</span>
            @{
              var seminars = Model.Seminar;
              foreach (var s in seminars) {
                <span class="article-tag">
                  <a asp-action="Index" asp-controller="Seminar" asp-route-id="@s.Id">@s.Title</a>
                </span>
              }
            }
          </div>
        }
        @{
          if (!string.IsNullOrEmpty(Model.Label)) {
            <div class="article-tags-row">
              <span style="font-weight:600;color:#1566b6;font-size:1.06rem;">标签：</span>
              @foreach (string s in Model.Label.Split([',', '，'], StringSplitOptions.RemoveEmptyEntries)) {
                <span class="article-tag">
                  <a asp-action="Tag" asp-controller="Home" asp-route-tag="@s">
                    @s
                  </a>
                </span>
              }
            </div>
          }
        }
      </div>
    </section>
    <!-- 内容区 -->
    <section class="article-content-card">
      <div class="article-content">
        @if (DateTime.Now - Model.ModifyDate > TimeSpan.FromDays(365)) {
          <div class="old-card">
            该文章已经超过1年未更新，可能无法为您提供及时准确的资讯，请根据当下实际情况，酌情参考本文内容。
          </div>
        }
        @Html.Raw(Model.Content)
      </div>
      @{
        await Html.RenderPartialAsync("/Views/Post/ProtectContent.cshtml", Model);
      }
      @if (ad != null) {
        await Html.RenderPartialAsync("_ArticleListAdvertisement", ad);
      }
      <!-- 文章内容区 点赞+点踩按钮、历史版本次数显示示例 -->
      <div class="article-footer-row">
        <div class="like-btn-group">
          <button :disabled="disableVoteUp" @@click="voteUp" class="like-btn"> 👍赞 </button>
          <span class="like-count">{{voteUpCount}}</span>
          <button :disabled="disableVoteDown" @@click="voteDown" class="dislike-btn"> 👎踩 </button>
          <span class="dislike-count">{{voteDownCount}}</span>
        </div>
        @if (Model.Rss) {
          <a asp-action="PostRss" asp-controller="Subscribe" asp-route-id="@Model.Id" target="_blank">
            <button class="subscribe-btn" type="button">
              &#128233; 订阅本文章更新
            </button>
          </a>
        }
        @if (ViewBag.HistoryCount > 0) {
          <a asp-action="History" asp-controller="Post" asp-route-id="@Model.Id" class="history-link">
            文章历史版本
            <span style="background:#eaf6ff;color:#1566b6;border-radius:6px;padding:2px 10px;font-size:.98rem;margin-left:4px;">修改 @ViewBag.HistoryCount 次</span>
          </a>
        }
      </div>
      <div class="nav-links">
        @{
          PostModelBase prev = ViewBag.Prev;
          if (prev != null) {
            <a asp-action="Details" asp-controller="Post" asp-route-id="@prev.Id" class="nav-link">上一篇：@prev.Title</a>
          }

          PostModelBase next = ViewBag.Next;
          if (next != null) {
            <a asp-action="Details" asp-controller="Post" asp-route-id="@next.Id" class="nav-link">下一篇：@next.Title</a>
          }
        }
      </div>
      @{
        var posts = (IDictionary<int, string>) ViewBag.Related;
        if (posts.Count > 1) {
          <div class="recommend-card">
            <h2 class="recommend-title" id="recommend">相关推荐</h2>
            <ul class="recommend-list">
              @foreach (var item in posts) {
                <li class="recommend-item">
                  <a asp-action="Details" asp-controller="Post" asp-route-id="@item.Key">@item.Value</a>
                </li>
              }
            </ul>
          </div>
        }
      }
      <div class="copyright-card">
        <h2 class="recommend-title" id="copyright">版权声明</h2>
        @if (Model.DisableCopy) {
          <text>🈲⚠本文为作者原创，仅用于本站访客学习、研究和交流目的，未经授权禁止转载。️⚠🈲</text>
        } else {
          <text>
            本文仅用于学习、研究和交流目的，欢迎非商业性质转载。本文链接：
            <a asp-action="Details" asp-controller="Post" asp-route-id="@Model.Id">@HttpUtility.UrlDecode(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)</a>。
          </text>
          @Html.Raw(CommonHelper.SystemSettings["Disclaimer"])
        }
      </div>
    </section>
    <!-- 打赏：支付宝当面付扫码支付（无需登录，扫码在支付宝 App 内完成，不需要域名备案） -->
    <div class="donate-section" style="text-align:center;margin:28px 0 8px;">
      <button type="button" class="comment-form-btn" id="donateOpenBtn">☕ 打赏作者</button>
      <p style="margin:8px 0 0;color:#888;font-size:.92rem;">如果文章对你有帮助，欢迎扫码打赏支持，金额随意</p>
    </div>
    <div id="donateModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.5);align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:12px;width:420px;max-width:92vw;padding:24px;box-shadow:0 8px 32px rgba(0,0,0,.25);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <h3 style="margin:0;font-size:1.15rem;color:#1566b6;">☕ 打赏作者</h3>
          <button type="button" id="donateCloseBtn" style="border:none;background:none;font-size:1.4rem;color:#999;cursor:pointer;">×</button>
        </div>
        <div id="donateStepAmount">
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;" id="donateAmountBtns">
            <button type="button" class="donate-amount-btn" data-amount="1" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥1</button>
            <button type="button" class="donate-amount-btn" data-amount="5" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥5</button>
            <button type="button" class="donate-amount-btn" data-amount="10" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥10</button>
            <button type="button" class="donate-amount-btn" data-amount="20" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥20</button>
            <button type="button" class="donate-amount-btn" data-amount="50" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥50</button>
            <button type="button" class="donate-amount-btn" data-amount="100" style="flex:1;min-width:60px;padding:9px 0;border:1px solid #bcd7f5;border-radius:8px;background:#f5f9ff;color:#1566b6;font-size:1rem;cursor:pointer;">¥100</button>
          </div>
          <input type="number" id="donateCustomAmount" min="0.01" max="10000" step="0.01" placeholder="自定义金额（0.01-10000 元）" style="width:100%;padding:9px 12px;border:1px solid #bcd7f5;border-radius:8px;margin-bottom:12px;box-sizing:border-box;" />
          <input type="text" id="donateNickName" maxlength="32" placeholder="昵称（可选，默认“热心网友”）" style="width:100%;padding:9px 12px;border:1px solid #bcd7f5;border-radius:8px;margin-bottom:12px;box-sizing:border-box;" />
          <input type="text" id="donateMessage" maxlength="200" placeholder="留言（可选，最长 200 字）" style="width:100%;padding:9px 12px;border:1px solid #bcd7f5;border-radius:8px;margin-bottom:12px;box-sizing:border-box;" />
          <button type="button" class="comment-form-btn" id="donateCreateBtn" style="width:100%;">生成支付二维码</button>
          <p id="donateError" style="display:none;margin:10px 0 0;color:#d32f2f;font-size:.92rem;"></p>
        </div>
        <div id="donateStepQr" style="display:none;text-align:center;">
          <p style="margin:0 0 8px;font-size:1.05rem;">请用<span style="color:#1677ff;font-weight:600;">支付宝 App</span>扫码支付 <span id="donatePayAmount" style="color:#d32f2f;font-weight:700;"></span></p>
          <div id="donateQrCode" style="display:flex;justify-content:center;margin:12px 0;"></div>
          <p style="margin:0 0 4px;color:#888;font-size:.9rem;">订单号：<span id="donateOrderNo"></span></p>
          <p style="margin:0 0 12px;color:#888;font-size:.9rem;">二维码 <span id="donateCountdown"></span> 后过期，过期请重新下单</p>
          <p id="donatePayStatus" style="margin:0 0 12px;color:#1566b6;font-size:.95rem;">等待支付…</p>
          <button type="button" class="comment-form-btn" id="donateBackBtn" style="background:#fff;color:#1566b6;border:1px solid #bcd7f5;">返回重选金额</button>
        </div>
        <div id="donateStepSuccess" style="display:none;text-align:center;">
          <p style="font-size:2.2rem;margin:8px 0 4px;">🎉</p>
          <p style="margin:0 0 8px;font-size:1.1rem;color:#2e7d32;font-weight:600;">支付成功，感谢打赏！</p>
          <p style="margin:0 0 16px;color:#888;font-size:.92rem;">打赏 <span id="donateSuccessAmount"></span> 已收到，感谢你的支持</p>
          <button type="button" class="comment-form-btn" id="donateDoneBtn" style="width:100%;">完成</button>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
      (function () {
        var selectedAmount = 0, currentOrderNo = '', pollTimer = null, countdownTimer = null, expiresAt = null;
        function showStep(name) {
          $('#donateStepAmount').toggle(name === 'amount');
          $('#donateStepQr').toggle(name === 'qr');
          $('#donateStepSuccess').toggle(name === 'success');
        }
        function stopPolling() {
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
        }
        function openModal() {
          stopPolling();
          selectedAmount = 0;
          $('#donateCustomAmount').val('');
          $('#donateNickName').val('');
          $('#donateMessage').val('');
          $('#donateError').hide();
          $('.donate-amount-btn').css({ background: '#f5f9ff', color: '#1566b6' });
          showStep('amount');
          $('#donateModal').css('display', 'flex');
        }
        function closeModal() {
          stopPolling();
          $('#donateModal').hide();
        }
        $('#donateOpenBtn').on('click', openModal);
        $('#donateCloseBtn').on('click', closeModal);
        $('#donateDoneBtn').on('click', closeModal);
        $('#donateModal').on('click', function (e) { if (e.target === this) closeModal(); });
        $('#donateBackBtn').on('click', function () { stopPolling(); showStep('amount'); });
        $('.donate-amount-btn').on('click', function () {
          selectedAmount = parseFloat($(this).data('amount'));
          $('#donateCustomAmount').val(selectedAmount);
          $('.donate-amount-btn').css({ background: '#f5f9ff', color: '#1566b6' });
          $(this).css({ background: '#1e90ff', color: '#fff' });
        });
        $('#donateCustomAmount').on('input', function () {
          selectedAmount = parseFloat($(this).val()) || 0;
          $('.donate-amount-btn').css({ background: '#f5f9ff', color: '#1566b6' });
        });
        function startCountdown() {
          if (countdownTimer) clearInterval(countdownTimer);
          countdownTimer = setInterval(function () {
            var remain = Math.max(0, Math.floor((expiresAt - Date.now()) / 1000));
            var h = Math.floor(remain / 3600), m = Math.floor((remain % 3600) / 60), s = remain % 60;
            $('#donateCountdown').text(h + '小时' + String(m).padStart(2, '0') + '分' + String(s).padStart(2, '0') + '秒');
            if (remain <= 0) { stopPolling(); $('#donatePayStatus').text('二维码已过期，请返回重选金额重新下单。'); }
          }, 1000);
        }
        function startPolling() {
          if (pollTimer) clearInterval(pollTimer);
          pollTimer = setInterval(function () {
            $.getJSON('/DonatePay/QueryStatus', { orderNo: currentOrderNo }).done(function (res) {
              if (!res || !res.Success || !res.Data) return;
              if (res.Data.OrderStatus === 1) {
                stopPolling();
                $('#donateSuccessAmount').text('¥' + Number(res.Data.Amount).toFixed(2));
                showStep('success');
              } else if (res.Data.OrderStatus === 2) {
                stopPolling();
                $('#donatePayStatus').text('订单已关闭，请返回重选金额重新下单。');
              }
            });
          }, 3000);
        }
        $('#donateCreateBtn').on('click', function () {
          var amount = parseFloat($('#donateCustomAmount').val()) || selectedAmount;
          if (!amount || amount < 0.01 || amount > 10000) {
            $('#donateError').text('金额须在 0.01 至 10000 元之间。').show();
            return;
          }
          amount = Math.round(amount * 100) / 100;
          var btn = $(this);
          btn.prop('disabled', true).text('生成中…');
          $('#donateError').hide();
          $.ajax({
            url: '/DonatePay/Create',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ amount: amount, nickName: $('#donateNickName').val(), message: $('#donateMessage').val() })
          }).done(function (res) {
            btn.prop('disabled', false).text('生成支付二维码');
            if (!res || !res.Success || !res.Data || !res.Data.QrCode) {
              $('#donateError').text((res && res.Message) || '生成支付二维码失败，请稍后重试。').show();
              return;
            }
            currentOrderNo = res.Data.OrderNo;
            expiresAt = new Date(res.Data.ExpiresAt).getTime();
            $('#donatePayAmount').text('¥' + Number(res.Data.Amount).toFixed(2));
            $('#donateOrderNo').text(res.Data.OrderNo);
            $('#donateQrCode').empty();
            try {
              new QRCode(document.getElementById('donateQrCode'), { text: res.Data.QrCode, width: 200, height: 200, correctLevel: QRCode.CorrectLevel.M });
            } catch (e) {
              $('#donateQrCode').html('<p style="color:#d32f2f;">二维码生成失败，请刷新页面重试。</p>');
              return;
            }
            $('#donatePayStatus').text('等待支付…');
            showStep('qr');
            startCountdown();
            startPolling();
          }).fail(function () {
            btn.prop('disabled', false).text('生成支付二维码');
            $('#donateError').text('网络异常，请稍后重试。').show();
          });
        });
      })();
    </script>
    <section class="comment-section">
      <div class="comment-form">
        <h2 class="comment-list-title" id="comment">评论区</h2>
        @Html.AntiForgeryToken()
        @if (blogUser == null) {
          <div class="comment-login-tip" style="padding:18px;border:1px dashed #bcd7f5;border-radius:10px;background:#f5f9ff;text-align:center;">
            <p style="margin:0 0 12px;font-size:1.02rem;color:#333;">登录后才能发表评论</p>
            <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
              @if (AppConfig.OAuth.GitHub.Enabled) {
                <a class="comment-form-btn" href="/Login/GitHub?returnUrl=@loginReturnUrl" style="text-decoration:none;">使用 GitHub 登录</a>
              }
              @if (AppConfig.OAuth.Google.Enabled) {
                <a class="comment-form-btn" href="/Login/Google?returnUrl=@loginReturnUrl" style="text-decoration:none;">使用 Google 登录</a>
              }
              <a class="comment-form-btn" href="/Passport/Login?from=@loginReturnUrl" style="text-decoration:none;">账号密码登录</a>
            </div>
          </div>
        } else {
          <p>@blogUser.NickName 您好，您已登录，可以直接发表评论。</p>
          <!-- 第二行：评论内容框独占一行 -->
          <div class="comment-form-row" style="width:100%;margin-top:12px;">
            <div class="ueditor" id="editor"></div>
          </div>
          <!-- 第三行：协议勾选和提交按钮同一行，右侧提交按钮 -->
          <div class="comment-form-row" style="display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:18px;">
            <label style="display:flex;align-items:center;font-size:.98rem;color:#1566b6;gap:6px;">
              <input name="agreement" required style="width:18px;height:18px;margin-right:4px;" type="checkbox" v-model="msg.Agree">
              我已阅读并同意
              <a asp-action="agreement" asp-controller="Misc" style="color:#1e90ff;text-decoration:underline;" target="_blank">《评论须知》</a>
            </label>
            <button @@click="submit(msg)" class="comment-form-btn">提交评论</button>
          </div>
        }
      </div>
      <parent-messages :data="list" :is-admin="false" @@getmsgs="getcomments" @@reply-msg="replyMsg"></parent-messages>
      <n-pagination :page-count="Math.ceil(pageConfig.total / pageConfig.size)" :page-sizes="[10, 20, 30, 50]" show-size-picker v-if="pageConfig.total > 0" v-model:page="pageConfig.page" v-model:page-size="pageConfig.size"/>
      <h4 v-if="pageConfig.total == 0">还没有评论哦，赶紧来写评论吧</h4>
    </section>
  </div>
  <n-modal :mask-closable="false" :title="`回复：${reply.for?.NickName}`" @@positive-click="submit(reply)" negative-text="取消回复" positive-text="回复评论" preset="dialog" style="width:70vw;min-width:400px" v-model:show="showPopup">
    <div class="comment-item" style="max-height: 50vh;overflow-y: scroll;">
      <div class="comment-meta-row">
        <div>
          <span class="comment-author">{{reply.for?.NickName}}</span>
          <span class="comment-time">{{ reply.for?.CommentDate }}</span>
        </div>
      </div>
      <div class="comment-content" v-html="reply.for?.Content"></div>
    </div>
    <form class="comment-form">
      @Html.AntiForgeryToken()
      @if (blogUser == null) {
        <div class="comment-login-tip" style="padding:18px;border:1px dashed #bcd7f5;border-radius:10px;background:#f5f9ff;text-align:center;">
          <p style="margin:0 0 12px;font-size:1.02rem;color:#333;">登录后才能回复评论</p>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            @if (AppConfig.OAuth.GitHub.Enabled) {
              <a class="comment-form-btn" href="/Login/GitHub?returnUrl=@loginReturnUrl" style="text-decoration:none;">使用 GitHub 登录</a>
            }
            @if (AppConfig.OAuth.Google.Enabled) {
              <a class="comment-form-btn" href="/Login/Google?returnUrl=@loginReturnUrl" style="text-decoration:none;">使用 Google 登录</a>
            }
            <a class="comment-form-btn" href="/Passport/Login?from=@loginReturnUrl" style="text-decoration:none;">账号密码登录</a>
          </div>
        </div>
      } else {
        <p>@blogUser.NickName 您好，您已登录。</p>
        <!-- 第二行：评论内容框独占一行 -->
        <div class="comment-form-row" style="width:100%;margin-top:12px;">
          <div class="ueditor" id="editor2"></div>
        </div>
        <!-- 第三行：协议勾选和提交按钮同一行，右侧提交按钮 -->
        <div class="comment-form-row" style="display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:18px;">
          <label style="display:flex;align-items:center;font-size:.98rem;color:#1566b6;gap:6px;">
            <input name="agreement" required style="width:18px;height:18px;margin-right:4px;" type="checkbox" v-model="reply.Agree">
            我已阅读并同意
            <a asp-action="agreement" asp-controller="Misc" style="color:#1e90ff;text-decoration:underline;" target="_blank">《评论须知》</a>
          </label>
        </div>
      }
    </form>
  </n-modal>
</div>
@if (Model.DisableCopy) {
  <style>
        /* webkit, opera, IE9 （谷歌浏览器）*/
        ::selection {
            background: transparent;
        }
        /* mozilla firefox（火狐浏览器） */
        ::-moz-selection {
            background: transparent;
        }
    </style>
}
<environment names="Development">
  <link href="~/UEditorPlus/third-party/SyntaxHighlighter/shCoreDefault.css" rel="stylesheet"/>
  <script src="/UEditorPlus/third-party/SyntaxHighlighter/shCore.js"></script>
  <link href="~/Assets/auto-toc/auto-toc.css" rel="stylesheet"/>
  <script src="/Assets/auto-toc/auto-toc.js"></script>
  <script src="/Scripts/global/article.js"></script>
</environment>
<environment names="Stage,Production">
  @await Styles.RenderAsync("/bundles/article.css")
  <script defer src="@(await Scripts.UrlAsync("/bundles/article.js"))"></script>
</environment>
<script>
    @if (Model.DisableCopy) {
      <text>
    GlobalCopyrightProtect();
        </text>
    }
</script>