@using Masuit.MyBlogs.Core.Models.Entity
@using Masuit.MyBlogs.Core.Models.Enum
@model AppOrder
@{
  ViewBag.Title = "支付结果";
  var license = ViewBag.IssuedLicense as AppLicense;
  string ExpireText(AppLicense l) => l.ExpireDate >= l.StartDate.AddYears(99) ? "永久" : l.ExpireDate.ToString("yyyy-MM-dd");
}
<style>
  .store-head { margin: 16px 0 6px; }
  .pay-ok { border: 1px solid #9ccc9c; background: #eef7ee; color: #27632a; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
  .pay-wait { border: 1px solid #bcd3ea; background: #eef4fb; color: #20507f; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
  .pay-warn { border: 1px solid #f0c36d; background: #fdf6e3; color: #7a5b12; border-radius: 8px; padding: 16px; margin-bottom: 16px; }
  .pay-key { font-family: monospace; word-break: break-all; background: #fff; border: 1px dashed #9ccc9c; border-radius: 6px; padding: 8px 10px; margin-top: 8px; }
</style>
<h2 class="store-head">支付结果</h2>
<p>订单号：@Model.OrderNo · @(Model.Application?.Name ?? "-") · @Model.PlanName · ¥@Model.Amount.ToString("0.00")</p>

@if (Model.OrderStatus == AppOrderStatus.Paid)
{
  <div class="pay-ok">
    <strong>支付成功！</strong>授权已自动发放到您的账号。
    @if (license != null)
    {
      <div>生效日期：@license.StartDate.ToString("yyyy-MM-dd") · 到期：@ExpireText(license)</div>
      <div class="pay-key">授权码：@license.LicenseKey</div>
    }
  </div>
}
else if (Model.OrderStatus == AppOrderStatus.Closed)
{
  <div class="pay-warn">该订单已关闭。如需购买，请返回商店重新下单。</div>
}
else
{
  <div class="pay-wait">
    <strong>正在等待支付宝确认支付结果。</strong><br />
    如果您已完成付款，授权通常会在几十秒内自动发放，请稍后刷新本页或到「我的订单」查看；
    如果尚未付款，可以点下方按钮继续支付。
  </div>
  <p>
    <a href="/Store/Pay/@Model.Id">继续支付 / 查看订单</a>
    · <a href="/Store/MyOrders">我的订单</a>
  </p>
  <script>setTimeout(function () { location.reload(); }, 8000);</script>
}
<p><a href="/Store/MyOrders">我的订单</a> · <a href="/Store">返回商店</a></p>
