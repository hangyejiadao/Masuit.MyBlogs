@{
  ViewBag.Title = "用户中心登录";
  var returnUrl = ViewBag.ReturnUrl as string ?? "/UserCenter";
  var oauthReturnParam = "?returnUrl=" + System.Net.WebUtility.UrlEncode(returnUrl);
}
  <style>
    .uc-login-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 36px 12px 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, #eaf3fb 0%, #d7e8f7 100%);
    }
    .uc-login-card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 28px rgba(21,102,182,.14);
      padding: 40px 36px;
      width: 380px;
      max-width: calc(100vw - 32px);
    }
    .uc-login-title {
      text-align: center;
      font-weight: 700;
      font-size: 1.7rem;
      color: #1566b6;
      letter-spacing: 1px;
    }
    .uc-login-sub {
      text-align: center;
      color: #888;
      font-size: .92rem;
      margin: 8px 0 26px;
    }
    .uc-form { display: flex; flex-direction: column; gap: 15px; }
    .input-group { display: flex; flex-direction: column; gap: 6px; }
    .input-group label { font-size: .98rem; color: #444; font-weight: 500; }
    .input-group input[type="text"], .input-group input[type="password"] {
      padding: 11px 12px;
      border-radius: 8px;
      border: 1px solid #d8e2ec;
      font-size: 1rem;
      outline: none;
      transition: border .2s;
    }
    .input-group input:focus { border-color: #1566b6; background: #f5f9ff; }
    .captcha-group { display: flex; gap: 8px; align-items: center; }
    .captcha-group input { flex: 1; min-width: 0; }
    .captcha-img {
      width: 100px;
      height: 40px;
      background: #eee;
      border-radius: 6px;
      cursor: pointer;
      object-fit: cover;
      border: 1px solid #d8e2ec;
    }
    .options-row { display: flex; align-items: center; gap: 8px; font-size: .95rem; color: #444; }
    .options-row input { accent-color: #1566b6; width: 17px; height: 17px; }
    .login-btn {
      width: 100%;
      margin-top: 6px;
      background: #1566b6;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 1.05rem;
      font-weight: 700;
      padding: 13px 0;
      cursor: pointer;
      transition: background .2s;
    }
    .login-btn:hover { background: #0f5294; }
    .error-message {
      color: #c0392b;
      background: #fdecea;
      border-radius: 6px;
      padding: 8px 12px;
      font-size: .95rem;
      display: none;
    }
    .error-message.show { display: block; }
    .oauth-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #999;
      font-size: .9rem;
      margin-top: 6px;
    }
    .oauth-divider::before, .oauth-divider::after { content: ''; flex: 1; height: 1px; background: #e8e8e8; }
    .oauth-btns { display: flex; gap: 12px; }
    .oauth-btn {
      flex: 1;
      text-align: center;
      padding: 10px 0;
      border-radius: 8px;
      border: 1px solid #d8e2ec;
      background: #fff;
      color: #333;
      font-size: .98rem;
      font-weight: 600;
      text-decoration: none;
      transition: border .2s, box-shadow .2s;
    }
    .oauth-btn:hover { border-color: #1566b6; box-shadow: 0 4px 14px rgba(21,102,182,.12); }
    .uc-login-footer { text-align: center; margin-top: 20px; font-size: .92rem; }
    .uc-login-footer a { color: #1566b6; text-decoration: none; }
    .uc-login-footer a:hover { text-decoration: underline; }
  </style>
<div class="uc-login-wrap">
<div id="app">
  <div class="uc-login-card">
    <div class="uc-login-title">用户中心登录</div>
    <p class="uc-login-sub">普通用户专属入口 · 查看购买记录与已购授权</p>
    @Html.AntiForgeryToken()
    <div class="uc-form">
      <div :class="{show:errorMessage}" class="error-message">{{ errorMessage }}</div>
      <div class="input-group">
        <label for="username">用户名</label>
        <input id="username" maxlength="20" placeholder="请输入用户名" required type="text" v-model="username">
      </div>
      <div class="input-group">
        <label for="password">密码</label>
        <input id="password" maxlength="20" placeholder="请输入密码" required type="password" v-model="password" @@keyup.enter="handleLogin">
      </div>
      <div class="input-group">
        <label for="captcha">验证码</label>
        <div class="captcha-group">
          <input autocomplete="off" id="captcha" maxlength="4" placeholder="请输入验证码" required type="text" v-model="captchaInput" @@keyup.enter="handleLogin">
          <img :src="captchaImgUrl" @@click="refreshCaptcha" alt="验证码" class="captcha-img" title="点击刷新">
        </div>
      </div>
      <div class="options-row">
        <input id="remember" type="checkbox" v-model="remember">
        <label for="remember">记住密码</label>
      </div>
      <button @@click="handleLogin" class="login-btn" type="submit">登录用户中心</button>
      @if (Masuit.MyBlogs.Core.Configs.AppConfig.OAuth.GitHub.Enabled || Masuit.MyBlogs.Core.Configs.AppConfig.OAuth.Google.Enabled) {
        <div class="oauth-divider"><span>或使用第三方账号登录</span></div>
        <div class="oauth-btns">
          @if (Masuit.MyBlogs.Core.Configs.AppConfig.OAuth.GitHub.Enabled) {
            <a class="oauth-btn" href="/Login/GitHub@(oauthReturnParam)">GitHub 登录</a>
          }
          @if (Masuit.MyBlogs.Core.Configs.AppConfig.OAuth.Google.Enabled) {
            <a class="oauth-btn" href="/Login/Google@(oauthReturnParam)">Google 登录</a>
          }
        </div>
      }
    </div>
    <div class="uc-login-footer">
      <a href="/">← 返回博客首页</a>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/vue@3.5.16/dist/vue.global.prod.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsencrypt/3.5.4/jsencrypt.min.js"></script>
<script>
      const returnUrl = @Json.Serialize(returnUrl);
      const { createApp } = Vue;
      createApp({
        data() {
          return {
            username: '',
            password: '',
            captchaInput: '',
            ramdom: Date.now(),
            remember: false,
            errorMessage: '',
          }
        },
        computed: {
          captchaImgUrl() {
            return `/Passport/ValidateCode?t=${this.ramdom || Date.now()}`;
          }
        },
        methods: {
          refreshCaptcha() {
            this.ramdom = Date.now();
          },
          async handleLogin() {
            this.errorMessage = '';
            if (this.username.trim().length < 3) {
              this.errorMessage = "用户名长度需≥3位";
              return;
            }
            if (this.password.length < 6) {
              this.errorMessage = "密码长度需≥6位";
              return;
            }
            if (this.captchaInput.trim().length < 4) {
              this.errorMessage = "请输入4位验证码";
              return;
            }
            const cookie = await cookieStore.get("PublicKey");
            var encrypt = new JSEncrypt();
            encrypt.setPublicKey(decodeURIComponent(cookie.value));
            axios.create({
        headers: {
          'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        }
      }).post('/Passport/Login', {
              username: this.username.trim(),
              password: encrypt.encrypt(this.password),
              valid: this.captchaInput.trim(),
              remem: this.remember
            }).then(res => {
              if (res.data.Success) {
                window.location.href = returnUrl;
              } else {
                this.errorMessage = res.data.Message || '登录失败，请重试';
                this.refreshCaptcha();
                this.captchaInput = '';
              }
            }).catch(() => {
              this.errorMessage = '网络异常，请稍后重试';
              this.refreshCaptcha();
              this.captchaInput = '';
            });
          }
        },
        mounted() {
          this.refreshCaptcha();
        }
      }).mount('#app')
</script>
</div>
