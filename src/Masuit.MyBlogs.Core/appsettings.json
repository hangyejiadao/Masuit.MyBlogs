{
    "DetailedErrors": true,
    "Logging": {
        "LogLevel": {
            "Default": "Information" // 日志级别，线上环境建议设置成Error级别
        }
    },
    "AllowedHosts": "*",
    "Port": 5000, // http监听端口
    "Https": {
        "Enabled": true, // 启用https跳转
        "Port": 5001, // https监听端口
        "CertPath": "App_Data/cert/server.pfx", // https证书路径
        "CertPassword": "YourSecurePassword" // 证书密码
    },
    "Database": {
        "ConnString": "host=10.8.0.3;port=5433;Username=myblogs;Password=sALhiQkDA8aBXeKHMNSrFDT5Fb2x;sslmode=disable;Database=myblogs" // 数据库连接字符串
    },
    "Redis": "10.8.0.3:6380,password=iKZuLH7oUCC65YoHMWps4BkzedhJ,allowadmin=true,connectTimeout=20000,connectRetry=1,responseTimeout=20000,syncTimeout=10000", // Redis连接字符串
    "EmailDomainWhiteList": [ "masuit.com", "ldqk.org", "[a-zA-z]{5,32}@qq.com", "\\d{6,12}@qq.com", "[a-zA-Z0-9]{6,16}@vip.qq.com", "\\w{5,32}@163.com", "\\w{5,32}@gmail.com", "\\w{5,36}@outlook.com" ], // 邮箱域名白名单正则表达式
    "EmailDomainBlockList": [ ".*" ], // 邮箱域名黑名单正则表达式
    "UseRewriter": "NonWww", //NonWww:重定向到不带www的域名，WWW：重定向到带www的域名
    "TrueClientIPHeader": "CF-Connecting-IP", // 若有CDN，取客户端真实IP的请求头，裸奔留空即可
    "EnableIPDirect": false, // 是否允许IP直接访问
    "MailSender": "smtp", // 为空则使用smtp发送
    "MailgunConfig": { // MailSender选项为Mailgun时本配置节生效
        "apikey": "mailgun的apikey", // mailgun的apikey
        "from": "admin@mail.masuit.com" // mailgun平台的发件箱账号
    },
    "FirewallService": { // 防火墙服务上报模块配置
        "type": "cloudflare", // cloudflare或none
        "Cloudflare": { // type为cloudflare时生效
            "Scope": "accounts", // 范围：accounts、zones
            "ZoneId": "区域或账户id", // 区域或账户id，scope为accounts则填账户id，scope为zones则填zoneid
            "AuthEmail": "授权邮箱账号", // 授权邮箱账号
            "AuthKey": "AuthKey" // apikey
        }
    },
    "OAuth": { // 第三方单点登录，ClientId 和 ClientSecret 都填写后对应平台才启用，留空则不显示该平台的登录入口
        "GitHub": { // 在 GitHub Settings → Developer settings → OAuth Apps 创建，回调地址填 https://站点域名/signin-github
            "ClientId": "",
            "ClientSecret": ""
        },
        "Google": { // 在 Google Cloud Console → APIs 和服务 → 凭据创建 OAuth 客户端，重定向 URI 填 https://站点域名/signin-google
            "ClientId": "",
            "ClientSecret": ""
        }
    },
    "Alipay": { // 支付宝支付（前台「软件购买」商店收款）：在支付宝开放平台 https://open.alipay.com 创建应用并签约「电脑网站支付」后填写；Enabled=true 且 AppId/PrivateKey/AlipayPublicKey 都填写后才启用，未配置时支付页只提示联系管理员、订单保持待支付
        "Enabled": false, // 是否启用支付宝支付
        "AppId": "", // 开放平台应用的 AppId
        "PrivateKey": "", // 应用私钥（商户私钥，PKCS8 格式），用开放平台密钥工具生成，与上传到平台的应用公钥配对；只能填服务器上的这份配置，严禁提交真实密钥到代码仓库
        "AlipayPublicKey": "", // 支付宝公钥：把应用公钥上传到开放平台后，平台生成的那串支付宝公钥（不是应用公钥本身）
        "Gateway": "https://openapi.alipay.com/gateway.do", // 正式环境网关；沙箱联调改成 https://openapi-sandbox.dl.alipaydev.com/gateway.do
        "NotifyUrl": "", // 支付异步通知地址，留空自动用 https://站点域名/Store/AlipayNotify
        "ReturnUrl": "" // 支付后浏览器同步跳回地址，留空自动用 https://站点域名/Store/Result
    },
    "WeChatMp": { // 微信公众号文章推送（按个人订阅号设计）：博客文章同步到公众号草稿箱（可选自动发表）。在微信公众平台 https://mp.weixin.qq.com 「开发 - 基本配置」里拿 AppID/AppSecret，并把服务器出口 IP 加进同页的 IP 白名单，否则拿 access_token 会报 40164；Enabled=true 且 AppId/AppSecret 都填写后才启用，未配置时推送接口直接拒绝。注意：个人订阅号自 2025 年 7 月起已被微信回收发布接口（freepublish/submit）权限，AutoPublish=true 会报 48001，草稿仍保留、需在公众号后台或「公众号助手」App 手动发表/群发；订阅号手动群发每天 1 次、一次最多 8 篇，文章进粉丝的订阅号消息列表
        "Enabled": false, // 是否启用微信公众号文章推送
        "AppId": "", // 公众号的 AppID
        "AppSecret": "", // 公众号的 AppSecret，只能填服务器上的这份配置，严禁提交真实密钥到代码仓库
        "AutoPublish": false, // 建草稿后是否自动提交发表（调 freepublish/submit）。默认 false 只进草稿箱、由管理员在公众号后台或「公众号助手」App 手动发表/群发；true 会尝试调发布接口，但个人订阅号自 2025 年 7 月起已被微信回收该权限，会报 48001（草稿仍保留、可手动发表），只有企业主体已认证的账号能调通
        "DefaultThumbMediaId": "", // 默认封面永久素材 media_id（可选）。文章里没有图片、又没填这里时推送会失败；封面素材先在公众号后台「素材管理 - 图片」上传再取 media_id
        "ApiBaseUrl": "https://api.weixin.qq.com" // 微信 API 根地址，一般不用改
    },
    "RequestLogStorage": "database", // 请求日志存储介质，file 或 database 或 none，默认none
    "PerfCounterStorage": "database", // 性能监控存储介质，memory 或 database，默认memory
    "Imgbed": { // 图床相关配置
        "EnableLocalStorage": true, // 允许本地硬盘存储？
        "EnableExternalImgbed": true, // 允许上传至第三方图床(网易图床/Sohu图床/头条图床)？
        "Gitlabs": [ // gitlab图床配置，空数组则代表不启用
            //{
            //    "ApiUrl": "https://gitlab.com/api/v4/projects/<你的项目id>/repository/files/", // /api/v4/projects/<项目id>/repository/files/，使用前请先获取private_token
            //    "RawUrl": "https://gitlab.com/<用户名>/<项目仓库名>/raw/master/",
            //    "AccessToken": "你的private_token",
            //    "Branch": "master",
            //    "FileLimitSize": 104857600
            //},
            {
               "ApiUrl": "https://api.github.com/repos/hangyejiadao/PicturesBed/contents/", // github上传API地址
               "RawUrl": "https://cdn.jsdelivr.net/gh/hangyejiadao/PicturesBed/",
               "AccessToken": "", //access_token在github个人中心获取，https://github.com/settings/tokens
               "Branch": "main",
               "FileLimitSize": 1048576
            }
        ]
    },
    "HttpClientProxy": { // HttpClient代理设置
        "Enabled": true,
        "Uri": "http://127.0.0.1:7890", // 支持http模式和pac模式的代理
        "UriPrefix": "" //httpClient请求地址前缀：https://example.com/
    },
    "ReverseProxy": { // Yarp反向代理配置，无需使用保持现状即可，参考文档：https://microsoft.github.io/reverse-proxy/articles/getting-started.html
        "Routes": {
        },
        "Clusters": {
        }
    },
    "ReverseTunnel": { // 内网穿透客户端来源白名单；支持单个IP与CIDR，留空表示不限制来源地址
        "AllowedClientIps": []
    }
